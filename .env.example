# Public Vite variables. The Supabase anon/publishable key may be exposed to
# browsers only when Row Level Security is enabled and tested in Supabase.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never put service-role, Stripe, or LLM provider secrets in VITE_* variables.
# Configure those only as encrypted Vercel server-side environment variables.
